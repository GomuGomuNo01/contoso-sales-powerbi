model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["CheminDonnees","Ventes","Produits","Magasins","Clients","Mesures"]

ref table Ventes
ref table Produits
ref table Magasins
ref table Clients
ref table Mesures
ref table Calendrier

ref cultureInfo fr-FR


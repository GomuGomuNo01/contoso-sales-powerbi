	column 'Jour de la semaine'
		dataType: string
		lineageTag: 89b75dc7-8c27-41be-aa2d-55c4f1bec1e6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Jour de la semaine]
		sortByColumn: 'N° jour de la semaine'

		annotation SummarizationSetBy = User

	partition Calendrier = calculated
		mode: import
		source =
				VAR DateDebut = DATE ( YEAR ( MIN ( Ventes[Date de commande] ) ), 1, 1 )
				VAR DateFin = DATE ( YEAR ( MAX ( Ventes[Date de commande] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( DateDebut, DateFin ),
				        "Année", YEAR ( [Date] ),
				        "N° trimestre", QUARTER ( [Date] ),
				        "Trimestre", "T" & QUARTER ( [Date] ),
				        "N° mois", MONTH ( [Date] ),
				        "Mois", UPPER ( LEFT ( FORMAT ( [Date], "mmmm", "fr-FR" ), 1 ) ) & MID ( FORMAT ( [Date], "mmmm", "fr-FR" ), 2, 20 ),
				        "Mois court", UPPER ( LEFT ( FORMAT ( [Date], "mmm", "fr-FR" ), 1 ) ) & MID ( FORMAT ( [Date], "mmm", "fr-FR" ), 2, 20 ),
				        "N° année-mois", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Année-mois", FORMAT ( [Date], "mmm yyyy", "fr-FR" ),
				        "N° jour de la semaine", WEEKDAY ( [Date], 2 ),
				        "Jour de la semaine", UPPER ( LEFT ( FORMAT ( [Date], "dddd", "fr-FR" ), 1 ) ) & MID ( FORMAT ( [Date], "dddd", "fr-FR" ), 2, 20 )
				    )

